<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!--
        只暴露 cache/update 这一个子目录，安装器拿到的 content:// 无法遍历到应用的其他私有数据。
        合成后的 APK 就落在这里，安装完成后由 UpdateRepository 主动清理。
    -->
    <cache-path
        name="app_update"
        path="update/" />
    <!-- 本地生成的打卡分享图，仅应用私有 files/share 目录可见，分享时由 FileProvider 授予一次性读权限 -->
    <files-path
        name="share"
        path="share/" />
</paths>
